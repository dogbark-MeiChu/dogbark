# Copy to dev/demoConsole/.env (gitignored) and fill in. Only DEMO_DB_PASSWORD is required.

# --- ssh tunnel ------------------------------------------------------------
DEMO_SSH_HOST=sh17-devel-mc-hackathon-04
DEMO_LOCAL_PORT=6543
DEMO_REMOTE_HOST=127.0.0.1
DEMO_REMOTE_PORT=5432
DEMO_AUTO_TUNNEL=1
# Private key handed to ssh as -i. Must be mode 600. Leave blank to use ssh's own defaults
# (~/.ssh/config IdentityFile and the agent).
DEMO_SSH_KEY=~/.ssh/id_ed25519

# --- database (reached through the tunnel) ---------------------------------
# Either give the whole URL:
# DEMO_DATABASE_URL=postgres://agrilink_app:PASSWORD@127.0.0.1:6543/agrilink
# ...or just the parts (the URL is then built for you):
DEMO_DB_USER=agrilink_app
DEMO_DB_PASSWORD=
DEMO_DB_NAME=agrilink

# Only needed for the destructive "Delete all demo market data" action: the append-only triggers
# on market_events / market_offer_revisions can only be bypassed by a superuser.
# DEMO_RESET_DATABASE_URL=postgres://postgres:PASSWORD@127.0.0.1:6543/agrilink

# --- console ---------------------------------------------------------------
DEMO_CONSOLE_PORT=4180
DEMO_SNAPSHOT_DIR=~/demo-snapshots
# Optional. Only a code you want to read off the handset needs the VM's real secret; deals can be
# advanced with any 32+ character value because the console both derives and verifies the code.
# MARKET_CODE_SECRET=
